# .env.example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it contains secrets!

# ===== GOOGLE GEMINI API (Production) =====
# Get your API key from: https://console.cloud.google.com/
# 1. Create project: "SOPIA_Production"
# 2. Enable "Generative AI API"
# 3. Create API Key in Credentials
GOOGLE_API_KEY=AIza_YOUR_API_KEY_HERE

# Alternative API keys (for backup/rotation)
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=

# ===== TWILIO WHATSAPP =====
# Get from: https://www.twilio.com/console/phone-numbers/incoming
# Account SID: Get from console dashboard
TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID_HERE

# Auth Token: Get from console (KEEP SECRET!)
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE

# WhatsApp number (with +1 country code)
TWILIO_WHATSAPP_NUMBER=+1234567890

# ===== TELEGRAM BOT (FREE messaging channel) =====
# Get token from Telegram: message @BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJK...

# Where the bot sends questions (your Render URL + /chat)
SOPIA_API_URL=https://sopia-mvp.onrender.com/chat

# ===== APP CONFIGURATION =====
GEMINI_MODEL=models/gemini-3.6-flash
DEBUG=False
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production

# ===== SECURITY =====
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===== DATABASE (Optional) =====
DATABASE_URL=
